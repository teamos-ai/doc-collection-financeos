{
  "name": "doc-collection-financeos",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5319",
    "build": "tsc --noEmit && vite build && node scripts/check-site-build.mjs",
    "build:portable": "tsc --noEmit && vite build --mode portable",
    "test": "node scripts/check-model.mjs && node scripts/check-intake.mjs && node scripts/check-blueprint.mjs && node scripts/sync-docs.mjs",
    "package": "npm run build:portable && sh scripts/package.sh",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "typescript": "5.5.4",
    "vite": "5.4.8",
    "@playwright/test": "1.58.2"
  }
}
